{
  "info": {
    "name": "LR16 — Inventory API",
    "description": "Run the collection in order against the Docker Compose lab. A unique SKU is generated on each run and the test product is deleted at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8016",
      "type": "string"
    },
    {
      "key": "sku",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Database responds\", () => { pm.expect(pm.response.json()).to.eql({ status: \"ok\" }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 OpenAPI schema",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"All five CRUD operations are documented\", () => { const paths = pm.response.json().paths; pm.expect(paths[\"/products\"]).to.include.keys(\"get\", \"post\"); pm.expect(paths[\"/products/{product_id}\"]).to.include.keys(\"get\", \"put\", \"delete\"); });",
              "pm.test(\"Validation and conflict response schemas are present\", () => { const responses = pm.response.json().paths[\"/products\"].post.responses; pm.expect(responses).to.include.keys(\"422\", \"409\"); pm.expect(responses[\"422\"].content[\"application/json\"].schema.$ref).to.include(\"ValidationErrorMessage\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openapi.json"
          ]
        }
      }
    },
    {
      "name": "03 Create product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const guid = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").toUpperCase();",
              "pm.collectionVariables.set(\"sku\", \"LAB-\" + guid.slice(0, 24));",
              "pm.collectionVariables.unset(\"productId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const product = pm.response.json();",
              "pm.collectionVariables.set(\"productId\", product.id);",
              "pm.test(\"Product fields are returned\", () => { pm.expect(product).to.include({ sku: pm.collectionVariables.get(\"sku\"), name: \"USB-C cable\", quantity: 3 }); });",
              "pm.test(\"Location points to the new resource\", () => { pm.expect(product.id).to.be.a(\"number\").and.above(0); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/products/\" + product.id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"USB-C cable\",\n  \"quantity\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"List is paginated and sorted by ID\", () => { const products = pm.response.json(); pm.expect(products).to.be.an(\"array\"); pm.expect(products.length).to.be.within(1, 100); pm.expect(products.every((product, index) => index === 0 || product.id > products[index - 1].id)).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "name": "05 Read product by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Stored fields match the request\", () => { pm.expect(pm.response.json()).to.eql({ id: Number(pm.collectionVariables.get(\"productId\")), sku: pm.collectionVariables.get(\"sku\"), name: \"USB-C cable\", quantity: 3 }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "06 Replace product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replacement preserves the ID\", () => { pm.expect(pm.response.json()).to.eql({ id: Number(pm.collectionVariables.get(\"productId\")), sku: pm.collectionVariables.get(\"sku\"), name: \"USB-C cable, 2 m\", quantity: 8 }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"USB-C cable, 2 m\",\n  \"quantity\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Read after replacement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replacement is stored in the database\", () => { pm.expect(pm.response.json()).to.include({ name: \"USB-C cable, 2 m\", quantity: 8 }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "08 Duplicate SKU",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Error message is present\", () => { pm.expect(pm.response.json().detail).to.eql(\"SKU already exists.\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"USB-C cable\",\n  \"quantity\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Negative quantity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Validation identifies quantity\", () => { const body = pm.response.json(); pm.expect(body.detail).to.eql(\"Invalid request data.\"); pm.expect(body.errors.some(error => error.location.includes(\"quantity\") && error.message.length > 0)).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"INVALID-NEGATIVE\",\n  \"name\": \"USB-C cable\",\n  \"quantity\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Quantity with wrong type",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Validation identifies quantity\", () => { const body = pm.response.json(); pm.expect(body.detail).to.eql(\"Invalid request data.\"); pm.expect(body.errors.some(error => error.location.includes(\"quantity\") && error.message.length > 0)).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"INVALID-TYPE\",\n  \"name\": \"USB-C cable\",\n  \"quantity\": \"3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 Malformed JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Validation identifies body\", () => { const body = pm.response.json(); pm.expect(body.detail).to.eql(\"Invalid request data.\"); pm.expect(body.errors.some(error => error.location.includes(\"body\") && error.message.length > 0)).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"BROKEN\",",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 Invalid product ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Validation identifies product_id\", () => { const body = pm.response.json(); pm.expect(body.detail).to.eql(\"Invalid request data.\"); pm.expect(body.errors.some(error => error.location.includes(\"product_id\") && error.message.length > 0)).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/invalid",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "invalid"
          ]
        }
      }
    },
    {
      "name": "13 Invalid page limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Validation identifies limit\", () => { const body = pm.response.json(); pm.expect(body.detail).to.eql(\"Invalid request data.\"); pm.expect(body.errors.some(error => error.location.includes(\"limit\") && error.message.length > 0)).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?limit=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "limit",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "name": "14 Delete product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Response body is empty\", () => { pm.expect(pm.response.text()).to.eql(\"\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "15 Read deleted product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error message is present\", () => { pm.expect(pm.response.json().detail).to.eql(\"Product not found.\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "16 Health after errors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Database responds\", () => { pm.expect(pm.response.json()).to.eql({ status: \"ok\" }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    }
  ]
}
